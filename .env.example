# PostgreSQL (must match docker-compose.yml port if using Docker)
POSTGRES_USER=ora
POSTGRES_PASSWORD=ora_dev
POSTGRES_DB=ora
DATABASE_URL=postgresql://ora:ora_dev@localhost:5433/ora

# Anthropic API key (for Tier B LLM extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path to the directory containing source PDFs and SI spreadsheets
# Default: C:\Users\p\Documents\Satoru\ORA  (Windows)
ORA_DATA_DIR=C:\Users\p\Documents\Satoru\ORA

# Output directory for extracted JSON intermediates
ORA_EXTRACTED_DIR=data/processed/extracted
