{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ORA residue record",
  "description": "One analysed sherd/vessel from a British or Irish Neolithic pottery lipid residue study.",
  "type": "object",
  "required": [
    "sample_id", "source", "provenance_of_value",
    "reference_context", "region", "site",
    "ceramic_type", "period",
    "d13C_16_0", "d13C_18_0", "delta_13C",
    "analytical", "qa"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if":   { "properties": { "provenance_of_value": { "const": "reused" } } },
      "then": {
        "required": ["original_doi"],
        "properties": { "original_doi": { "type": "string" } }
      },
      "else": {
        "properties": {
          "original_doi":       { "type": "null" },
          "original_record_id": { "type": "null" }
        }
      }
    }
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "description": "The paper's own label for the sherd or vessel"
    },
    "source": {
      "type": "object",
      "required": ["citation", "doi", "table_or_figure", "extraction_route"],
      "additionalProperties": false,
      "properties": {
        "citation":         { "type": "string" },
        "doi":              { "type": "string" },
        "table_or_figure":  { "type": "string" },
        "extraction_route": {
          "type": "string",
          "enum": ["tierA_parse", "tierB_llm", "tierC_figure"]
        }
      }
    },
    "provenance_of_value": {
      "type": "string",
      "enum": ["original", "reused"],
      "description": "First numeric report (tabulated or stated in text). 'original': this record's paper is the first to report the value numerically. 'reused': the value was numerically reported in an earlier publication. A figure-only plot is not a numeric report."
    },
    "original_doi": {
      "type": ["string", "null"],
      "description": "For reused values: DOI of the publication that first reported the value numerically. Null for original values."
    },
    "original_record_id": {
      "type": ["string", "null"],
      "description": "For reused values: sample_id of the original record when it is itself in the corpus (identified together with original_doi). When populated, this record is excluded from independence-implying counts."
    },
    "prior_graphical_report": {
      "type": ["string", "null"],
      "description": "DOI of an earlier publication that plotted the value without tabulating it."
    },
    "provenance_note": {
      "type": ["string", "null"],
      "description": "Free-text note on the value's provenance."
    },
    "reference_context": {
      "type": "string",
      "description": "Interpretive context the record belongs to. Currently always 'british_irish'; exists so other contexts can be added without a migration."
    },
    "region": {
      "type": "string",
      "enum": ["Britain", "Ireland"]
    },
    "site":    { "type": "string" },
    "site_lat":  { "type": ["number", "null"] },
    "site_long": { "type": ["number", "null"] },
    "context":   { "type": ["string", "null"] },
    "ceramic_type": { "type": "string" },
    "period": {
      "type": "string",
      "enum": [
        "Early Neolithic",
        "Middle Neolithic",
        "Late Neolithic",
        "Neolithic (unspec)"
      ]
    },
    "date_range_bce": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        { "type": "null" }
      ]
    },
    "d13C_16_0": {
      "type": "number",
      "description": "δ¹³C of C16:0 fatty acid (per mille, ‰)"
    },
    "d13C_18_0": {
      "type": "number",
      "description": "δ¹³C of C18:0 fatty acid (per mille, ‰)"
    },
    "delta_13C": {
      "type": "number",
      "description": "Δ¹³C = δ¹³C18:0 − δ¹³C16:0 (per mille, ‰); computed wherever not reported"
    },
    "d2H_16_0": {
      "type": ["number", "null"],
      "description": "δ²H of C16:0 if reported"
    },
    "author_assignment": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ruminant dairy",
            "ruminant adipose",
            "non-ruminant/porcine",
            "aquatic",
            "mixed",
            "none"
          ]
        },
        { "type": "null" }
      ],
      "description": "Authors' own commodity call, exactly as stated. Never overwritten by tool."
    },
    "analytical": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "extraction_method": { "type": ["string", "null"] },
        "derivatisation":    { "type": ["string", "null"] },
        "instrument":        { "type": ["string", "null"] },
        "lab":               { "type": ["string", "null"] }
      }
    },
    "qa": {
      "type": "object",
      "required": ["value_from", "extraction_confidence"],
      "additionalProperties": false,
      "properties": {
        "value_from": {
          "type": "string",
          "enum": ["table", "figure", "text"]
        },
        "extraction_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "qa_notes": {
          "type": "string",
          "description": "Optional free-text QA note explaining a flag or verification outcome"
        }
      }
    }
  }
}
